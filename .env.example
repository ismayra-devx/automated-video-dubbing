# Optional configuration settings
# The system runs fully offline/local by default with free components.

# Default Whisper Model: tiny, base, small, medium (base or small recommended for CPU)
WHISPER_MODEL=base

# Default Edge-TTS English Voice:
# Female: en-US-AriaNeural, en-US-JennyNeural, en-GB-SoniaNeural
# Male: en-US-ChristopherNeural, en-US-GuyNeural, en-GB-RyanNeural
TTS_VOICE=en-US-ChristopherNeural

# FFmpeg binary path override (if not detected in system PATH)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
